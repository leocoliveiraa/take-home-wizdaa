generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Balance {
  id                 String           @id @default(cuid())
  employeeId         String
  locationId         String
  authoritativeUnits Float
  reservedUnits      Float            @default(0)
  version            Int              @default(0)
  lastSyncedAt       DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  requests           TimeOffRequest[]

  @@unique([employeeId, locationId])
}

model TimeOffRequest {
  id             String               @id @default(cuid())
  employeeId     String
  locationId     String
  balanceId      String
  units          Float
  reason         String?
  requestedBy    String?
  approvedBy     String?
  failureReason  String?
  hcmReference   String?
  idempotencyKey String?              @unique
  status         TimeOffRequestStatus @default(PENDING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  approvedAt     DateTime?
  rejectedAt     DateTime?
  canceledAt     DateTime?
  balance        Balance              @relation(fields: [balanceId], references: [id], onDelete: Restrict)
}

enum TimeOffRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
  SYNC_FAILED
}
